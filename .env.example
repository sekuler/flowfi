# Server-side only (Vercel serverless functions under /api).
# No VITE_ prefix — a VITE_ prefix bundles the value into client-side JS,
# exposing it in the browser. None of these should ever have that prefix.

ANTHROPIC_API_KEY=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
DROPSTAB_API_KEY=
ARC_RPC_URL=       (optional — a keyed RPC provider for Arc Testnet, e.g. Alchemy;
                    falls back to the public https://rpc.testnet.arc.network if unset)
UPSTASH_REDIS_REST_URL=    (required for api/circle-wallet.js's email/OTP sign-in —
UPSTASH_REDIS_REST_TOKEN=   stores one-time codes and the email→wallet mapping, not
                             just rate limiting. Also used for shared rate limiting on
                             /api/claude and /api/dropstab. Free tier at upstash.com —
                             create a Redis database, both values are on its detail
                             page. Rate limiting on /api/claude and /api/dropstab
                             degrades to "off" if unset, but api/circle-wallet.js's
                             requestCode/verifyCode/contractCall/signTypedData/
                             getTransaction actions hard-fail (500) without it, since
                             it's identity infrastructure, not just a rate limit.)
WALLET_AUTH_SECRET=        (required for api/circle-wallet.js — any long random
                             string, e.g. `openssl rand -hex 32`. Signs the session
                             token issued after email verification; every
                             contractCall/signTypedData/getTransaction call is
                             checked against it. Keep this secret — anyone with it
                             could forge a session for any email.)
RESEND_API_KEY=            (required for api/circle-wallet.js to actually send the
                             verification code by email. Free tier at resend.com —
                             create an API key on their dashboard.)
RESEND_FROM_EMAIL=         (optional — the From address for verification emails,
                             e.g. "FlowFi <noreply@flowfi.finance>". Needs a domain
                             verified in Resend to use a flowfi.finance address;
                             falls back to Resend's own onboarding@resend.dev sender
                             if unset, which works immediately but looks less
                             trustworthy to recipients.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
