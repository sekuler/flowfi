# Server-side only (Vercel serverless functions under /api).
# No VITE_ prefix — a VITE_ prefix bundles the value into client-side JS,
# exposing it in the browser. None of these should ever have that prefix.

ANTHROPIC_API_KEY=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
DROPSTAB_API_KEY=
ARC_RPC_URL=       (optional — a keyed RPC provider for Arc Testnet, e.g. Alchemy;
                    falls back to the public https://rpc.testnet.arc.network if unset)
UPSTASH_REDIS_REST_URL=    (optional — shared rate limiting for /api/claude and
UPSTASH_REDIS_REST_TOKEN=   /api/dropstab across all serverless instances. Free tier
                             at upstash.com — create a Redis database, both values
                             are on its detail page. If unset, rate limiting on
                             those two endpoints is off entirely, not approximated.)
