# FlowFi — environment variables
#
# Server-side only (Vercel serverless functions under /api). NEVER add a
# VITE_ prefix to any of these — that prefix bundles the value into
# client-side JS, exposing it in the browser. This list was generated by
# grepping the actual codebase for every process.env.X and import.meta.env.X
# reference (2026-09-19), not written from memory — if you add a new env
# var to the code, add it here too so this stays accurate.

# ---- Required for the app to function at all ----

# Powers AI Copilot, market analysis, and the wallet Q&A assistant.
ANTHROPIC_API_KEY=

# ---- Mainnet Bridge & Swap (LI.FI) ----

# Client-exposed by design, like a Stripe publishable key — LI.FI's own
# widget needs this in the browser bundle. Without it, the Mainnet
# Bridge/Swap widget won't load at all.
VITE_LIFI_API_KEY=

# ---- Mainnet Dashboard / Home (Arc Mainnet explorer reads) ----

# Powers balance and activity reads on Arc Mainnet via Etherscan's official
# arc.etherscan.io API (api/arcscan-proxy.js's `network=mainnet` routing).
# Free tier from etherscan.io/apis is enough. Without it, Dashboard/Home's
# mainnet activity feed returns a 500.
ETHERSCAN_API_KEY=

# Falls back to Arc's own public mainnet RPC (rpc.mainnet.arc.io) if unset.
# Only needed if you want a keyed/premium RPC provider instead.
ARC_MAINNET_RPC_URL=

# ---- Testnet Circle Wallet (api/circle-wallet.js, TEST_API_KEY) ----

CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Signs the testnet Circle Wallet session cookie issued after email/OTP
# verification. Use a long, random value — treat it like any other signing
# secret (rotating it invalidates every existing testnet session).
WALLET_AUTH_SECRET=

# ---- Mainnet Circle Wallet + Gateway (api/circle-wallet-mainnet.js, REAL FUNDS) ----

# Circle LIVE credentials (production entity, separate from the testnet pair above).
# The API key is the full "LIVE_API_KEY:...:..." string.
CIRCLE_LIVE_API_KEY=
CIRCLE_LIVE_ENTITY_SECRET=

# Signs the MAINNET session cookie. Must be different from WALLET_AUTH_SECRET so a
# testnet session can never be accepted by the mainnet endpoint. Long and random;
# rotating it signs every mainnet Circle Wallet user out.
CIRCLE_LIVE_AUTH_SECRET=

# Optional. Holding cap per account in USD (default 100). While an account is over
# the cap, every action except withdraw is refused.
CIRCLE_LIVE_CAP_USD=

# Optional. Comma-separated Circle chain codes wallets are created on (see the file
# for the default). Contract actions run on Arc only.
CIRCLE_LIVE_CHAINS=

# Optional. Set to 1 to close the feature: no new sign-ups, withdrawals only.
CIRCLE_LIVE_WITHDRAW_ONLY=

# Also required by the mainnet Circle Wallet: UPSTASH_REDIS_REST_URL/TOKEN and
# RESEND_API_KEY (below).

# Falls back to Arc's public testnet RPC (rpc.testnet.arc.network) if unset.
# Only needed for a keyed/premium testnet RPC provider.
ARC_RPC_URL=

# ---- Optional (or required only by the feature named) ----

# Live token unlock/vesting data (api/dropstab.js). Falls back to the
# manually curated list in the app without it.
DROPSTAB_API_KEY=

# Shared caching + rate limiting for every backend endpoint. Required for
# Circle Wallet (testnet and mainnet), and in production /api/claude,
# /api/rpc-proxy and /api/upload-image refuse to serve without it. Strongly
# recommended for any real deployment — without both of these, rate limiting is off entirely
# (not approximated) and the explorer-proxy cache falls back to a
# per-instance in-memory Map, which barely helps on Vercel's serverless
# model (see arcscan-proxy.js's own comments on why that's not a real fix).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image uploads (api/upload-image.js, Testnet Token Launch) — Vercel Blob.
# Either the static token, or BLOB_STORE_ID which Vercel sets itself when the
# Blob store is connected via OIDC (nothing to set by hand in that case).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Outbound email: Circle Wallet one-time sign-in codes (testnet and mainnet).
# Required for Circle Wallet. RESEND_FROM_EMAIL should be a verified sender on
# your own domain, e.g. "FlowFi <no-reply@flowfi.finance>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Standard Node/Vercel environment flag — usually set automatically by the
# hosting platform, not something you need to set by hand locally.
NODE_ENV=development
